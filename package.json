    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo-google-fonts/caladea": "0.4.2",
    "@expo-google-fonts/carlito": "0.4.1",
    "@expo-google-fonts/cousine": "0.4.3",
    "@expo-google-fonts/tinos": "0.4.2",
    "jszip": "^3.10.2",
    "pdfjs-dist": "6.5.438",
